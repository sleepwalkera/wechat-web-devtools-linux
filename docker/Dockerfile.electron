FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        binutils \
        build-essential \
        ca-certificates \
        curl \
        g++-10 \
        gcc-10 \
        libffi-dev \
        libkrb5-dev \
        libssh2-1-dev \
        libssl-dev \
        libxkbfile-dev \
        lld \
        openssl \
        p7zip-full \
        pkg-config \
        python-is-python2 \
        python2 \
        python3 \
        python3-dev \
        unzip \
        wget \
        xz-utils \
        zlib1g-dev && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 90 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-10 && \
    rm -rf /var/lib/apt/lists/*

# 为构建环境提供 Node.js 和 npm，不依赖工作区中的 node/ 目录。
RUN curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource-setup.sh && \
    bash /tmp/nodesource-setup.sh && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -f /tmp/nodesource-setup.sh && \
    rm -rf /var/lib/apt/lists/*

# 注意：7z 由上方 apt 安装的 p7zip-full 提供（/usr/bin/7z），
# 不再从 www.7-zip.org 下载 —— 该站点会屏蔽 GitHub Actions 等云厂商 IP，
# 导致 CI 上 wget 失败（win32 exe 的解包依赖此工具）。
RUN node --version && npm --version && npx --version
